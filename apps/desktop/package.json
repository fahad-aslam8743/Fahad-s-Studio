{
  "name": "@irfan/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "concurrently -k \"tsc -w -p tsconfig.json\" \"wait-on http://localhost:3000 dist/main.js && cross-env IRFAN_DEV=1 electron .\"",
    "build": "tsc -p tsconfig.json",
    "dist:win": "pnpm build && electron-builder --win nsis --publish never",
    "dist:win:release": "pnpm build && electron-builder --win nsis --publish always",
    "verify:windows": "node scripts/verify-package.cjs"
  },
  "dependencies": {
    "zod": "^3.25.76",
    "electron-updater": "^6.6.2",
    "whatsapp-web.js": "1.34.7",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^38.3.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.3",
    "wait-on": "^8.0.5",
    "@types/qrcode": "^1.5.5",
    "@electron/asar": "^3.4.1"
  },
  "build": {
    "appId": "com.irfan.studio",
    "productName": "Irfan's Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../ui/out",
        "to": "ui"
      },
      {
        "from": "scripts",
        "to": "scripts"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "fahad-aslam8743",
        "repo": "Fahad-s-Studio",
        "releaseType": "release"
      }
    ]
  }
}
